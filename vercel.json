{
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/*.js": {
      "regions": [
        "iad1"
      ],
      "includeFiles": "{api/_fonts/**,js/agreement-data.js,js/contractor-docs.js}"
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|mp4|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
